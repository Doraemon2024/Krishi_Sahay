# KrishiSahay Server Environment Configuration
PORT=5000
NODE_ENV=development
UPLOAD_MAX_SIZE_MB=10
ALLOWED_CORS_ORIGIN=*

# Firebase Firestore Configuration (Optional)
# Option A: Place 'serviceAccountKey.json' in backend/config/ or backend/
# Option B: Set the absolute path to your Firebase service account JSON:
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option C: Direct credentials from Firebase Console:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
